# Copy this file to .env.local and fill in at least one provider key.
# .env.local is ignored by git and should never be committed.

# Provider selection order starts with VITE_AI_PROVIDER, then falls back to
# other providers with configured keys.
# Allowed values: openrouter, anthropic, gemini, openai
VITE_AI_PROVIDER=openrouter

# Provider API keys (set only what you use)
VITE_OPENROUTER_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=

# Optional model overrides
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional premium voice key
VITE_ELEVENLABS_API_KEY=
