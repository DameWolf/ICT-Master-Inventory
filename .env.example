# Copy this file to .env and fill in at least one API key.
# The .env file is in .gitignore and will NOT be committed to the repository.
#
# OpenAI keys: https://platform.openai.com/api-keys
# Gemini keys: https://aistudio.google.com/app/apikey
# ElevenLabs keys: https://elevenlabs.io/
# Optional code-integrated key file: src/config/aiKeys.js

VITE_OPENAI_API_KEY=sk-...your_openai_key_here...
VITE_GEMINI_API_KEY=AIza...your_gemini_key_here...
VITE_ELEVENLABS_API_KEY=...your_elevenlabs_key_here...
